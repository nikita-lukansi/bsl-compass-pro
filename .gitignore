__pycache__/
*.py[cod]
.env
# Бэкапы .env (роут настроек хабов) содержат секреты — в git не попадают;
# локальные оверлей-переменные тоже.
.env.bak-*
.env.*.local
target/
node_modules/
*.db
*.db-wal
*.db-shm
logs/
.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
# Бинарные артефакты 1С (внешние обработки) пересобираются из выгрузок —
# в git не складываются
*.epf

# Входные хабы дампов/корпусов: пользовательские данные, в репо не попадают
docs-dumps/
ext-dumps/

# Локальные каталоги данных и внутренних инструментов:
# в публичный репо не попадают — чистка дерева ДО дня публикации.
Изменения/
beads-board/
.beads/
workspace/
dumps/
backups/
inbox/
offline/
offline-exchange
