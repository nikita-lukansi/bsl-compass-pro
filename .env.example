# BSL Compass Pro
# Минимум для старта: ничего (пустой контейнер поднимется в bootstrap-режиме).
# Все пути ведут на хост: контейнер можно удалять/пересоздавать без потери индексов.
# Копируйте в .env и заполняйте.

# =============================================================================
# ИСТОЧНИК (обязательно) - пути к папкам
# =============================================================================

# Точки входа выгрузок (S3: read-only скан при добавлении; рабочая копия
# уезжает в volume /data/configs/<cid>/source — хост-дамп после этого
# можно удалить). Рабочего каталога WORKSPACE_HUB больше нет: системная
# зона (settings/бэкапы/логи) живёт в volume /data/system; офлайн-обмен —
# на хосте через OFFLINE_HUB (см. ниже).
# DUMPS_HUB=./dumps
# WORKSPACE_HUB=./workspace
# Хабы выгрузок расширений и готовых док-корпусов (compass-85s): read-only
# скан при добавлении, рабочие копии ядро кладёт в volume (/data/extensions,
# /data/configs/<cid>/help). Примеры внешнего пути — как DUMPS_HUB=Atlas_DumpsConf:
# EXT_HUB=D:/1C/ExtDumps       # выгрузки расширений: <Имя>/ (XML) или <Имя>.cfe
# DOCS_HUB=D:/1C/DocsDumps     # готовые корпуса справки: <source_id>/
# EXT_HUB=./ext-dumps
# DOCS_HUB=./docs-dumps

# Overrides для хост-запуска/тестов (в контейнере не нужны):
# COMPASS_CONFIGS_ROOT=  COMPASS_DOCS_ROOT=  COMPASS_EXTENSIONS_ROOT=
# COMPASS_SYSTEM_ROOT=   COMPASS_SETTINGS_PATH=
# COMPASS_BACKUPS_PATH=  COMPASS_INBOX_PATH=  COMPASS_OFFLINE_PATH=

# --- Офлайн-контур 1С ------------------------------------------------------
# Режим рантайма: offline — файловый обмен queue/resp с базой 1С (дефолт
# compose), online — HTTP к RUNTIME_URL. Значение в .env перекрывает
# дефолт compose.
# RUNTIME_MODE=offline
# Онлайн-режим: адрес HTTP-сервера рантайма 1С и токен авторизации
# (пусто = online-контур не настроен, data_query честно откажет).
# RUNTIME_URL=http://192.168.1.10/hs/compass
# RUNTIME_TOKEN=
# Офлайн-архив: хранить сырые (неанонимизированные) ответы в archive/
# (off — переанонимизация и деанон из архива недоступны) и TTL задач
# в секундах (дефолт 604800 = 7 суток).
# ARCHIVE_RAW=on
# ARCHIVE_TTL=604800
# Каталог обмена (queue/ archive/ results). Путь должен быть ДОСТУПЕН БАЗЕ
# 1С с хоста: обработка КомпасРантайм читает req_*.json и пишет resp_*.json
# в эту папку — укажите каталог, прокинутый в базу 1С (сетевой диск/папка).
# OFFLINE_HUB=./offline

# --- Сеть ---------------------------------------------------------------
MCP_PORT=8240
# SHA коммита для bake в образ (1mj.7, виден в /health и /api/status):
#   GIT_SHA=$(git rev-parse --short HEAD) docker compose build
# (пусто/dev = локальная сборка без bake)
GIT_SHA=
# Токен на мутирующие эндпоинты (пусто = доступ свободен, только localhost)
ADMIN_TOKEN=

# --- Qdrant --------------------------------------------------------------
# QDRANT_URL=http://qdrant:6333     # сервис compose (дефолт)
# QDRANT_URL=http://192.168.1.10:6333  # внешний сервер

# --- Семантический слой (режим full) ---------------------------------------
# OpenAI-совместимый провайдер эмбеддингов: BASE_URL и MODEL обязательны
# для векторизации (без них codesearch честно откажет, остальное работает).
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Таймаут запроса, сек; размер батча; инструктирование запросов (on/off)
# EMBEDDING_TIMEOUT=120
# EMBEDDING_BATCH=32
# EMBEDDING_QUERY_INSTRUCT=on

# --- Нотификации и бэкапы --------------------------------------------------
# Telegram-уведомления о сборках индекса: нужен и токен бота, и chat_id
# (пусто = выключено).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Авто-бэкап слепка индекса после каждой сборки (on/off) и сколько копий
# хранить (число, дефолт 3).
# BACKUP_AUTO=off
# BACKUP_KEEP=3

# --- Документация ИТС (обновление корпуса; без этого — только чтение) ------
# Учётная запись с доступом к its.1c.ru (договор ИТС ПРОФ / тест-драйв 7 дней).
# Пароль наружу не отдаётся и в логи не попадает; куки-сессия живёт в ОЗУ.
# ITS_LOGIN=
# ITS_PASSWORD=
# Альтернатива без пароля: строка Cookie из браузера (F12 → заголовок Cookie),
# например "PHPSESSID=...; SESSION=...; TGC=...". При заданной куки пароль не нужен.
# ITS_COOKIE=
# Пауза между запросами, сек (антибот-профиль: 2–3 с + джиттер)
# ITS_FETCH_DELAY=2.5

# --- Сайдбар панели: ссылки проекта ---------------------------------------
# Слаг репозитория (owner/name). Приватный репо → счётчик звёзд скрыт,
# ссылка работает. Дефолт: nikita-lukansi/bsl-compass-pro
# GITHUB_REPO=nikita-lukansi/bsl-compass-pro
# Telegram-профиль автора. Дефолт: https://t.me/programmer_nikita
# TELEGRAM_URL=https://t.me/programmer_nikita


# --- Проверка актуальности версии (compass-82a) -----------------------------
# SHA собранного образа vs HEAD main в GitHub. Токен нужен ТОЛЬКО пока репо
# приватное: fine-grained PAT, Contents Read-only. Пусто = ок для публичного
# репо; приватный без токена даст status "private" с этой же подсказкой.
GITHUB_TOKEN=
# Выключатель проверки (off — офлайн-контуры без выхода в интернет).
UPDATE_CHECK=on
